<Window x:Class="FastAndroidDataCopier.PhoneFolderBrowserDialog"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="📂 تصفح واختيار مجلد الوجهة داخل الهاتف"
Height="600" Width="740"
WindowStartupLocation="CenterOwner"
FlowDirection="RightToLeft"
Background="#0F172A" Foreground="#F8FAFC"
FontFamily="Segoe UI, Tahoma"
ResizeMode="CanResizeWithGrip">
<Window.Resources>
<Style x:Key="DialogButton" TargetType="Button">
<Setter Property="Background" Value="#3B82F6"/>
<Setter Property="Foreground" Value="White"/>
<Setter Property="FontWeight" Value="Bold"/>
<Setter Property="Padding" Value="12,7"/>
<Setter Property="BorderThickness" Value="0"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="Button">
<Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter TargetName="border" Property="Opacity" Value="0.88"/>
</Trigger>
<Trigger Property="IsEnabled" Value="False">
<Setter TargetName="border" Property="Opacity" Value="0.4"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
</Window.Resources>
<Grid Margin="14">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<TextBlock Grid.Column="0" Text="المسار الحالي:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0"/>
<TextBox x:Name="TxtCurrentRemotePath" Grid.Column="1" Text="/sdcard/" Background="#090D16" Foreground="#FDE047"
BorderBrush="#334155" Padding="8,6" FontSize="13" FlowDirection="LeftToRight" VerticalContentAlignment="Center"/>
<Button Grid.Column="2" Content="انتقال ↵" Click="BtnGoPath_Click" Style="{StaticResource DialogButton}" Background="#0284C7" Margin="6,0,0,0"/>
<Button Grid.Column="3" Content="🔄 تحديث" Click="BtnRefreshDir_Click" Style="{StaticResource DialogButton}" Background="#2563EB" Margin="6,0,0,0"/>
<Button Grid.Column="4" Content="⬆️ للأعلى" Click="BtnUp_Click" Style="{StaticResource DialogButton}" Background="#475569" Margin="6,0,0,0"/>
</Grid>
</Border>
<WrapPanel Grid.Row="1" Margin="0,0,0,8">
<TextBlock Text="اختصارات سريعة:" VerticalAlignment="Center" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,8,4"/>
<Button Content="📱 الذاكرة الداخلية (/sdcard/)" Tag="/sdcard/" Click="BtnQuickPath_Click" Style="{StaticResource DialogButton}" Background="#334155" Margin="0,0,6,4" Padding="10,5" FontSize="11.5"/>
<Button Content="📥 التنزيلات (Download)" Tag="/sdcard/Download/" Click="BtnQuickPath_Click" Style="{StaticResource DialogButton}" Background="#4F46E5" Margin="0,0,6,4" Padding="10,5" FontSize="11.5"/>
<Button Content="🎮 بيانات التطبيقات (Android/data)" Tag="/sdcard/Android/data/" Click="BtnQuickPath_Click" Style="{StaticResource DialogButton}" Background="#0369A1" Margin="0,0,6,4" Padding="10,5" FontSize="11.5"/>
<Button Content="📦 ملفات OBB (Android/obb)" Tag="/sdcard/Android/obb/" Click="BtnQuickPath_Click" Style="{StaticResource DialogButton}" Background="#0D9488" Margin="0,0,6,4" Padding="10,5" FontSize="11.5"/>
<Button Content="🎬 الأفلام والفيديو (Movies)" Tag="/sdcard/Movies/" Click="BtnQuickPath_Click" Style="{StaticResource DialogButton}" Background="#7C3AED" Margin="0,0,6,4" Padding="10,5" FontSize="11.5"/>
<Button Content="📷 الكاميرا (DCIM)" Tag="/sdcard/DCIM/" Click="BtnQuickPath_Click" Style="{StaticResource DialogButton}" Background="#D97706" Margin="0,0,6,4" Padding="10,5" FontSize="11.5"/>
</WrapPanel>
<Border Grid.Row="2" Background="#090D16" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="6">
<ListBox x:Name="LstFolders" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC"
MouseDoubleClick="LstFolders_MouseDoubleClick" FontSize="13.5">
<ListBox.ItemContainerStyle>
<Style TargetType="ListBoxItem">
<Setter Property="Padding" Value="10,8"/>
<Setter Property="Margin" Value="0,0,0,4"/>
<Setter Property="Background" Value="#1E293B"/>
<Setter Property="BorderBrush" Value="#334155"/>
<Setter Property="BorderThickness" Value="1"/>
</Style>
</ListBox.ItemContainerStyle>
</ListBox>
</Border>
<Border Grid.Row="3" Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="0,8,0,8" BorderBrush="#334155" BorderThickness="1">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<TextBlock Grid.Column="0" Text="إنشاء مجلد جديد هنا:" VerticalAlignment="Center" Foreground="#CBD5E1" Margin="0,0,8,0"/>
<TextBox x:Name="TxtNewFolderName" Grid.Column="1" Background="#090D16" Foreground="White" BorderBrush="#334155" Padding="8,5" FlowDirection="LeftToRight"/>
<Button Grid.Column="2" Content="➕ إنشاء المجلد والدخول إليه" Click="BtnCreateFolder_Click" Style="{StaticResource DialogButton}" Background="#059669" Margin="8,0,0,0"/>
</Grid>
</Border>
<Grid Grid.Row="4">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<TextBlock x:Name="TxtBrowserStatus" Grid.Column="0" Text="انقر مرتين على أي مجلد للدخول إليه، أو اضغط اعتماد المسار الحالي."
VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap"/>
<Button Grid.Column="1" Content="إلغاء" Click="BtnCancel_Click" Style="{StaticResource DialogButton}" Background="#EF4444" Margin="6,0,0,0"/>
<Button Grid.Column="2" Content="✅ اعتماد هذا المسار للنسخ" Click="BtnSelect_Click" Style="{StaticResource DialogButton}" Background="#10B981" Margin="8,0,0,0" Padding="18,8"/>
</Grid>
</Grid>
</Window>
