<Window x:Class="FastAndroidDataCopier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="منظومة النسخ السريع وتثبيت التطبيقات للأندرويد - Pro Edition v2.5" 
        Height="830" Width="1140"
        MinHeight="740" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Tahoma">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#090D16"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="18,12" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="⚡ منظومة النسخ الجماعي فائق السرعة والاستئناف الذكي (Multi-Device Copier Pro v2.5)" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox x:Name="ChkAutoDetectDevices" Content="🔌 التعرف التلقائي الفوري عند توصيل أو فصل أي هاتف" IsChecked="True"
                                  Foreground="#A7F3D0" FontWeight="SemiBold" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkAutoResumeOnReconnect" Content="🔄 استئناف النسخ تلقائياً فور إعادة توصيل الهاتف المفصول" IsChecked="True"
                                  Foreground="#FDE047" FontWeight="SemiBold" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtAdbStatusBadge" Text="🛠 جاري فحص محرك ADB..." FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0F172A" CornerRadius="8" Padding="14,8" Margin="8,0,0,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="حجم البيانات المصدر" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtFolderSizeInfo" Text="0.00 GB" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0F172A" CornerRadius="8" Padding="14,8" Margin="8,0,0,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="الأجهزة المتصلة" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtDevicesCount" Text="0 جهاز" FontSize="15" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="16,12" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="📁 المجلد المصدر (بالكمبيوتر):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                <TextBox x:Name="TxtSourceFolder" Grid.Row="0" Grid.Column="1" Text="" Style="{StaticResource ModernTextBox}" Foreground="#38BDF8" FlowDirection="LeftToRight"/>
                <Button Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Content="📂 اختيار المجلد من الكمبيوتر..." Click="BtnBrowseFolder_Click" Style="{StaticResource ModernButton}" Background="#0284C7" Margin="8,0,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="📦 ملف التطبيق (APK):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                <TextBox x:Name="TxtApkPath" Grid.Row="2" Grid.Column="1" Text="" Style="{StaticResource ModernTextBox}" Foreground="#A7F3D0" FlowDirection="LeftToRight"/>
                <Button Grid.Row="2" Grid.Column="2" Content="اختيار APK..." Click="BtnBrowseApk_Click" Style="{StaticResource ModernButton}" Background="#059669" Margin="8,0,0,0"/>
                <Button x:Name="BtnInstallApkOnly" Grid.Row="2" Grid.Column="3" Content="📲 تثبيت الـ APK فقط" Click="BtnInstallApkOnly_Click" Style="{StaticResource ModernButton}" Background="#0D9488" Margin="8,0,0,0"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="🎯 مسار النسخ داخل الهاتف:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                <TextBox x:Name="TxtTargetDest" Grid.Row="4" Grid.Column="1" Text="/sdcard/Download/" Style="{StaticResource ModernTextBox}" Foreground="#FDE047" FlowDirection="LeftToRight"/>
                <Button x:Name="BtnBrowsePhoneDest" Grid.Row="4" Grid.Column="2" Content="📱 تصفح مجلدات الهاتف..." Click="BtnBrowsePhoneDest_Click" Style="{StaticResource ModernButton}" Background="#7C3AED" Margin="8,0,0,0"/>

                <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="العملية:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#A7F3D0" FontWeight="Bold"/>
                    <ComboBox x:Name="CmbOperationMode" Width="215" SelectedIndex="0" Padding="8,5" FontWeight="SemiBold">
                        <ComboBoxItem Content="📁 نسخ الملفات فقط (بدون APK)"/>
                        <ComboBoxItem Content="📲 تثبيت الـ APK أولاً ثم نسخ الملفات"/>
                        <ComboBoxItem Content="📲 تثبيت الـ APK فقط"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnRefreshDevices" Grid.Column="0" Content="🔄 فحص وتحديث الآن" Click="BtnRefreshDevices_Click" 
                        Style="{StaticResource ModernButton}" Background="#2563EB"/>

                <Button x:Name="BtnRestartAdbServer" Grid.Column="1" Content="🛠 إعادة تنشيط ADB" Click="BtnRestartAdbServer_Click"
                        Style="{StaticResource ModernButton}" Background="#475569" Margin="8,0,0,0" ToolTip="إعادة تشغيل خادم ADB وتنظيف الأجهزة المعلقة"/>

                <CheckBox x:Name="ChkSelectAll" Grid.Column="2" Content="تحديد الكل" IsChecked="True" Checked="ChkSelectAll_Changed" Unchecked="ChkSelectAll_Changed"
                          VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold" Foreground="#E2E8F0"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkEnforceSpaceCheck" Content="منع النسخ إذا كانت المساحة غير كافية" IsChecked="True" 
                              VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#FBBF24" FontWeight="SemiBold"/>

                    <TextBlock Text="وضع الملفات والاستئناف:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbConflictMode" Width="260" SelectedIndex="1" Padding="8,5" FontWeight="SemiBold">
                        <ComboBoxItem Content="🔄 استبدال بالكامل (حذف القديم ونسخ الجديد)"/>
                        <ComboBoxItem Content="⏯ استئناف ذكي (إكمال الناقص وتخطي المنسوخ)"/>
                        <ComboBoxItem Content="➕ دمج شامل (نسخ وتحديث الكل بدون حذف)"/>
                        <ComboBoxItem Content="✏️ إعادة تسمية المجلد القديم والاحتفاظ به"/>
                    </ComboBox>

                    <TextBlock Text="البروتوكول:" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbTransferMode" Width="190" SelectedIndex="0" Padding="8,5" FontWeight="SemiBold">
                        <ComboBoxItem Content="📁 نقل مباشر مضمون (ADB Push)"/>
                        <ComboBoxItem Content="⚡ بث TAR القياسي فائق السرعة"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#090D16" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="10">
            <ListView x:Name="LvDevices" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="270"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ModelName}" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                                <TextBlock Text="{Binding Serial}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Padding="8,5" Margin="5,0" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding FreeSpaceText}" FontWeight="Bold" FontSize="12" Foreground="{Binding SpaceStatusColor}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SpaceVerdict}" FontSize="11" Foreground="{Binding SpaceStatusColor}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Column="3" VerticalAlignment="Center" Margin="14,0">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="24" 
                                             Background="#0F172A" Foreground="#10B981" BorderBrush="#334155" BorderThickness="1"/>
                                <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                           FontWeight="Bold" Foreground="White" FontSize="12"/>
                            </Grid>

                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="12" Foreground="#FDE047" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SpeedInfo}" FontSize="11" Foreground="#2DD4BF" TextAlignment="Right" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtGlobalStatus" Grid.Column="0" Text="🔌 جاري تهيئة محرك ADB وفحص الهواتف المتصلة..." 
                       VerticalAlignment="Center" FontSize="12.5" Foreground="#94A3B8" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <Button x:Name="BtnCancelAll" Grid.Column="1" Content="⏹ إيقاف الكل" Click="BtnCancelAll_Click" IsEnabled="False"
                    Style="{StaticResource ModernButton}" Background="#EF4444" Margin="6,0,0,0" Padding="14,10"/>

            <Button x:Name="BtnResumeCopy" Grid.Column="2" Content="⏯ استئناف النسخ من نقطة التوقف" Click="BtnResumeCopy_Click"
                    Style="{StaticResource ModernButton}" Background="#D97706" Margin="8,0,0,0" Padding="16,10"/>

            <Button x:Name="BtnCopyDataOnly" Grid.Column="3" Content="📁 نسخ فقط" Click="BtnCopyDataOnly_Click"
                    Style="{StaticResource ModernButton}" Background="#0284C7" Margin="8,0,0,0" Padding="16,10"/>

            <Button x:Name="BtnInstallAndCopy" Grid.Column="4" Content="🚀 تثبيت APK + نسخ" Click="BtnInstallAndCopy_Click"
                    Style="{StaticResource ModernButton}" Background="#10B981" Margin="8,0,0,0" FontSize="13.5" Padding="20,10"/>
        </Grid>

        <Border Grid.Row="5" Background="#1E293B" CornerRadius="8" Padding="12,8" BorderBrush="#38BDF8" BorderThickness="1">
            <TextBlock Text="تم تصميم وتطوير البرنامج بواسطة المهندس عبدالرحمن نبيل خشافة - 779020100" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
        </Border>
    </Grid>
</Window>
